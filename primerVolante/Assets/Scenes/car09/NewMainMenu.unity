  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>Ajuste de Postura y Altura del Asiento:</b>\n\nPara garantizar que alcances el volante, palanca y pedales con m\xE1xima comodidad y ergonom\xEDa:\n\n\u2022 <b>Durante las lecciones:</b> Pod\xE9s presionar en cualquier momento el bot\xF3n <b>Men\xFA</b> de tu control izquierdo (o tecla <b>Escape</b>) para abrir el men\xFA de pausa in-game y calibrar en vivo tu altura, distancia y alineaci\xF3n con respecto al volante.\n\n\u2022 <b>Recentrado de visor:</b> Si sent\xEDs que la orientaci\xF3n principal est\xE1 desplazada, manten\xE9 pulsado el bot\xF3n Oculus/Meta en el control derecho para recentrar el campo visual.\n\n\u2022 <b>Configuraci\xF3n guardada:</b> Tu calibraci\xF3n se guarda autom\xE1ticamente entre lecciones y se aplica al subirte al veh\xEDculo."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
