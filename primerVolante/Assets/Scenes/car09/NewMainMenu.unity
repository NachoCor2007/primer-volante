  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>Primer Volante</b> es una plataforma inmersiva de entrenamiento para nuevos conductores basada en Realidad Virtual.\n\n<b>Objetivo Pedag\xF3gico:</b>\nProveer un entorno seguro, progresivo y realista para que los estudiantes adquieran reflejos, automatismos en los mandos del veh\xEDculo, nociones de prioridad de paso, lectura de se\xF1alizaci\xF3n vial y respeto por las normas de tr\xE1nsito.\n\n<b>Caracter\xEDsticas del Simulador:</b>\n\u2022 F\xEDsica de veh\xEDculo calibrada y mandos de cabina bimanuales con agarre VR.\n\u2022 Sistema de detecci\xF3n y penalizaci\xF3n de infracciones viales en tiempo real.\n\u2022 Curr\xEDculum de 6 lecciones guiadas por voz y HUD visual.\n\u2022 Sistema de navegaci\xF3n GPS din\xE1mico en entorno urbano completo.\n\n<i>Versi\xF3n: 2.1 (Men\xFA VR Unificado y Accesible)</i>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
